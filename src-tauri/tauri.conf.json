{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PosStoreApp",
  "version": "0.1.3",
  "identifier": "com.egyptpos.store",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "POS Store",
        "width": 1600,
        "height": 950,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost https:"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Egypt POS Store",
    "category": "Business",
    "shortDescription": "برنامج إدارة المبيعات والمخازن والحسابات",
    "longDescription": "نظام محلي لإدارة أجهزة نقاط البيع، المبيعات، حساب الأرباح، وحركة المخزون مع دعم كامل للعملة المصرية والتشفير.",
    "copyright": "جميع الحقوق محفوظة © 2026",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mahmoudshahieen4-ux/inventory-managment-system/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NDg3QTQ3MEY0OEVFQQpSV1RxanZSd3BJZFVEQjgyc3RncjBLdEdwU0Z6L3ZXVnY4L3NSUjIyRXpIaG5CL1dldE9tVDhrSgo="
    },
    "sql": {
      "preload": ["sqlite:pos.db"]
    }
  }
}
