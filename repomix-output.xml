  --sidebar-border: #cbd5e1;
  --sidebar-ring: #2563eb;
}

.dark {
  /* Dark Theme */
  --font-sans: 'Rubik Variable', 'Inter Variable', 'Segoe UI', sans-serif;
  --background: #0f172a;
  --foreground: #f8fafc;
  --card: #1e293b;
  --card-foreground: #f8fafc;
  --popover: #1e293b;
  --popover-foreground: #f8fafc;
  --primary: #2563eb;
  --primary-foreground: #ffffff;
