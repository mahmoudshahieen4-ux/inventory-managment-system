}

:root {
  /* Light Theme - High Contrast Retail UI */
  --font-sans: 'Rubik Variable', 'Inter Variable', 'Segoe UI', sans-serif;

  /* Backgrounds & Contrast */
  --background: #f1f5f9; /* رمادي هادئ ومريح للعين يعزل العناصر تماماً */
  --foreground: #0f172a; /* نصوص داكنة بوضوح ممتاز */
